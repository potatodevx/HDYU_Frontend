// HDYU Phase 1 database schema.
// Dev default is SQLite (zero-setup). For production switch provider to
// "postgresql" and set DATABASE_URL to your Postgres connection string —
// no other schema change is needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  userId           String    @unique // human-readable id, e.g. HDYU-482913
  email            String    @unique
  passwordHash     String
  name             String
  role             String    @default("USER") // USER | ADMIN
  walletAddress    String?   @unique
  walletVerifiedAt DateTime?
  walletNonce      String?
  activities       ActivitySubmission[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ActivitySubmission {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userDbId], references: [id], onDelete: Cascade)
  userDbId     String
  category     String // GREEN_ACTIVITY | GARDENING | FARMING | GREEN_PURCHASE | TRAVEL | REFERRAL | CAMPAIGN
  title        String
  description  String
  proofUrl     String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | PROCESSING | PAID
  rewardAmount Float?
  adminNote    String?
  reviewedBy   String?
  reviewedAt   DateTime?
  payoutTx     String?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([userDbId])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  detail     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
